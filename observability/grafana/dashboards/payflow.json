     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "slo:payment_success:error_ratio_rate1h / 0.001",
     "legendFormat": "1h",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "C",
     "expr": "slo:payment_success:error_ratio_rate6h / 0.001",
     "legendFormat": "6h",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 7
  },
  {
   "type": "row",
   "title": "Payment flow",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "collapsed": false,
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "Processed / s by outcome",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 15
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(payments_processed_total[1m]))",
     "legendFormat": "{{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (kind) (rate(payments_dead_lettered_total[1m]))",
     "legendFormat": "dead-lettered: {{kind}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "End-to-end latency (accept -> commit)",
   "description": "Red line = the 2 s SLO threshold. The histogram tops out at 30 s, so a flat line at 30 s means 'at least 30 s'.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 15
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(payment_e2e_latency_seconds_bucket[1m])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(payment_e2e_latency_seconds_bucket[1m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(payment_e2e_latency_seconds_bucket[1m])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 10
  },
  {
   "type": "timeseries",
   "title": "Consumer lag by partition (broker side)",
   "description": "From kafka-exporter, so it keeps reporting when every consumer is down. Lag is a cause signal, not an SLI: a lag of 500 is fine at 1000/s and bad at 1/s.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 15
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (partition) (kafka_consumergroup_lag{consumergroup=\"payment-processor\",topic=\"payments.initiated\"})",
     "legendFormat": "p{{partition}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (consumergroup) (kafka_consumergroup_lag{consumergroup=~\"payment-processor-retry.*\"})",
     "legendFormat": "{{consumergroup}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 11
  },
  {
   "type": "row",
   "title": "Gateway (RED)",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 23
   },
   "collapsed": false,
   "id": 12
  },
  {
   "type": "timeseries",
   "title": "Requests / s by status",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"payment-gateway\",uri=\"/payments\"}[1m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 13
  },
  {
   "type": "timeseries",
   "title": "Error ratio (5xx)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "axisSoftMax": 0.05
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(http_server_requests_seconds_count{job=\"payment-gateway\",uri=\"/payments\",status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"payment-gateway\",uri=\"/payments\"}[1m]))",
     "legendFormat": "5xx ratio",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 14
  },
  {
   "type": "timeseries",
