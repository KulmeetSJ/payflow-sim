{
 "uid": "payflow",
 "title": "PayFlow Sim",
 "tags": [
  "payflow"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "SLOs (docs/slo.md)",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false,
   "id": 1
  },
  {
   "type": "stat",
   "title": "Latency SLO: error budget left (28d)",
   "description": "SLO: 99% of payments committed within 2 s of acceptance. 1 = untouched, 0 = spent.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:payment_latency:error_budget_remaining",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 2
  },
  {
   "type": "stat",
   "title": "Success SLO: error budget left (28d)",
   "description": "SLO: 99.9% of valid payments processed without being dead-lettered.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:payment_success:error_budget_remaining",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 3
  },
  {
   "type": "stat",
   "title": "Payments within 2 s (1h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.99
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - slo:payment_latency:error_ratio_rate1h",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 4
  },
  {
   "type": "stat",
   "title": "Alerts firing",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "noValue": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count by (alertname) (ALERTS{alertstate=\"firing\"})",
     "legendFormat": "{{alertname}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true,
     "range": false
    }
   ],
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Latency SLO burn rate",
   "description": "1x = spending the budget exactly over 28 days. Page when 1h AND 5m > 14.4x; ticket when 6h AND 30m > 6x.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 6
       },
       {
        "color": "red",
        "value": 14.4
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:payment_latency:error_ratio_rate5m / 0.01",
     "legendFormat": "5m",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "slo:payment_latency:error_ratio_rate1h / 0.01",
     "legendFormat": "1h",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "C",
     "expr": "slo:payment_latency:error_ratio_rate6h / 0.01",
     "legendFormat": "6h",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Success SLO burn rate",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "fieldConfig": {
