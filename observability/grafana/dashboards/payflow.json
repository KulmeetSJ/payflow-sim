   "id": 15
  },
  {
   "type": "row",
   "title": "Logs",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 32
   },
   "collapsed": false,
   "id": 16
  },
  {
   "type": "logs",
   "title": "Warnings and errors (click a line for its trace)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 33
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true,
